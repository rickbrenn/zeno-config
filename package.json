{
	"name": "zeno-config",
	"version": "6.0.0",
	"description": "Preconfigured and opinionated ESLint, Prettier, and TypeScript setup",
	"author": "Rick Brenn <brenn.rick@gmail.com>",
	"license": "MIT",
	"keywords": [
		"eslint",
		"prettier",
		"typescript",
		"config",
		"linting",
		"code-style",
		"react",
		"eslint-config"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rickbrenn/zeno-config.git"
	},
	"homepage": "https://github.com/rickbrenn/zeno-config#readme",
	"bugs": {
		"url": "https://github.com/rickbrenn/zeno-config/issues"
	},
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"inspect": "eslint --inspect-config",
		"lint": "eslint \"**/*.{js,cjs,mjs}\""
	},
	"exports": {
		"./eslint": {
			"types": "./src/eslint/index.d.ts",
			"default": "./src/eslint/index.js"
		},
		"./prettier": {
			"types": "./src/prettier.d.ts",
			"default": "./src/prettier.js"
		},
		"./tsconfig": "./src/tsconfig.base.json",
		"./tsconfig-server": "./src/tsconfig.server.json",
		"./tsconfig-react": "./src/tsconfig.react.json",
		"./extensions": {
			"types": "./src/extensions.d.ts",
			"default": "./src/extensions.js"
		}
	},
	"bin": {
		"zc-gitignore": "./bin/gitignore.js"
	},
	"files": [
		"src/**",
		"bin/**"
	],
	"peerDependencies": {
		"eslint": "^10.0.0",
		"prettier": "^3.9.0",
		"typescript": "^5.9.3 || ^6.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"eslint": "10.6.0",
		"prettier": "3.9.1",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-import-resolver-webpack": "0.13.11",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-n": "18.2.1",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.3",
		"eslint-plugin-react-you-might-not-need-an-effect": "1.0.1",
		"eslint-plugin-unicorn": "69.0.0",
		"globals": "17.7.0",
		"typescript-eslint": "8.62.0"
	}
}
